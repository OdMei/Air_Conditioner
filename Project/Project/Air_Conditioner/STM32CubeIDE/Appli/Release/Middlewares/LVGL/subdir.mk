LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/drivers/,$(src)),,$(src)))
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/libs/,$(src)),,$(src)))
LVGL_C_SRCS += $(LVGL_PATH)/src/libs/bin_decoder/lv_bin_decoder.c
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/others/,$(src)),,$(src)))
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/draw/nxp/,$(src)),,$(src)))
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/draw/renesas/,$(src)),,$(src)))
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/draw/sdl/,$(src)),,$(src)))
LVGL_C_SRCS := $(foreach src,$(LVGL_C_SRCS),$(if $(findstring /src/draw/vg_lite/,$(src)),,$(src)))
LVGL_OBJS := $(patsubst $(LVGL_PATH)/%.c,./Middlewares/LVGL/%.o,$(LVGL_C_SRCS))
LVGL_DEPS := $(LVGL_OBJS:.o=.d)
OBJS += $(LVGL_OBJS)
C_DEPS += $(LVGL_DEPS)

./Middlewares/LVGL/%.o: $(LVGL_PATH)/%.c
	arm-none-eabi-gcc $(LVGL_CFLAGS) "$<" -MF"$(@:%.o=%.d)" -MT"$@" -o "$@"

.PHONY: clean-lvgl
clean-lvgl:
	-$(RM) ./Middlewares/LVGL


